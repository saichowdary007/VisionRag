# VisionRag environment variables

# Vector store (Milvus Lite)
MILVUS_URI=./storage/milvus.db
COLLECTION_NAME=rag_vision_collection
IMAGE_DPI=200

# Retriever (ColPali)
RETRIEVER_MODEL_ID=vidore/colpali-v1.3
TOP_K_CANDIDATES=50
TOP_K_FINAL=3

# Question-answering LLM (OpenAI-compatible API)
QA_API_BASE=http://localhost:11434/v1
QA_API_KEY=ollama
QA_MODEL_ID=qwen2.5-vl:7b

# Optional overrides
# LOG_LEVEL=INFO
