# Vision-RAG minimal stack (.env.example)

# Data
DATA_DIR=/data

# LM Studio (VLM)
LMSTUDIO_BASE_URL=http://vlm:1234
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=google/gemma-3-12b-it

# Retriever service
RETRIEVER_BASE_URL=http://retriever:8081

# API bases (for constructing image URLs)
API_INTERNAL_BASE=http://api:8080
API_PUBLIC_BASE=http://localhost:8080

# Web allowed origin (dev)
WEB_ORIGIN=http://localhost:5173

# Rendering sizes
PAGE_MAX_DIM=1024
VLM_SQUARE=896
