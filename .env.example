# ColPali Retriever Configuration
RETRIEVER_MODEL_ID=vidore/colpali-v1.3
DEVICE=mps
IMAGE_DPI=200

# Milvus Vector Database
MILVUS_URI=./milvus.db
COLLECTION_NAME=rag_vision_collection
DIMENSION=128

# QA Model Configuration (Ollama/vLLM)
QA_API_BASE=http://localhost:11434/v1
QA_API_KEY=ollama
QA_MODEL_ID=qwen2.5vl

# Retrieval Parameters
TOP_K_CANDIDATES=50
TOP_K_FINAL=3

# Paths
SOURCE_DOCS_DIR=./documents
PAGE_IMAGE_DIR=./pages

# Next.js Configuration
NEXT_PUBLIC_APP_NAME="Chat Assistant"
NEXT_PUBLIC_APP_DESCRIPTION="AI-Powered Chat Interface"

# Development
NODE_ENV=development
