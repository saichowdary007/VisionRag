# Vision-RAG minimal stack (.env.example)

# Data
DATA_DIR=/data

# Retriever (Byaldi / ColPali)
RETRIEVER_MODEL=vidore/colpali-v1.2
RETRIEVER_INDEX_DIR=/data/index
RETRIEVER_DEVICE=cpu

# Retriever service
RETRIEVER_BASE_URL=http://retriever:8081

# API bases (for constructing image URLs)
# VLM inside Docker: API_INTERNAL_BASE=http://api:8080
# VLM on host:      API_INTERNAL_BASE=http://host.docker.internal:8080
API_INTERNAL_BASE=http://api:8080
API_PUBLIC_BASE=http://localhost:8080

# Web allowed origin (dev)
WEB_ORIGIN=http://localhost:5173

# Rendering sizes
PAGE_MAX_DIM=1024
VLM_SQUARE=896

# VLM (OpenAI-compatible: LM Studio / similar)
# If LM Studio runs as a container: VLM_BASE_URL=http://vlm:1234
VLM_BASE_URL=http://host.docker.internal:1234
VLM_API_KEY=lm-studio
VLM_MODEL=google/gemma-3-12b-it
VLM_MAX_IMAGES=5
TOP_K=5
HYBRID_ALPHA=0.2
RERANK=false
