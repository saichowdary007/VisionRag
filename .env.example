# Core retrieval configuration
COLLECTION_NAME=rag_documents
MILVUS_DB_PATH=./storage/milvus.db
TOP_K=3

# Embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
BATCH_SIZE=16
HF_CACHE_DIR=~/.cache/huggingface

# Ingestion
DOCUMENTS_DIR=./documents
CHUNK_SIZE=800
CHUNK_OVERLAP=100
SUPPORTED_FILE_TYPES=.txt,.md

# LLM configuration
LLM_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.1
MAX_TOKENS=512
USE_MOCK_LLM=false

# Optional Firecrawl search
FIRECRAWL_API_KEY=

# API behaviour
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
LOG_LEVEL=INFO
LOG_FILE=./logs/api_service.log
DEBUG=true
ENV=development
ENVIRONMENT=local

# Monitoring
ENABLE_METRICS=true
