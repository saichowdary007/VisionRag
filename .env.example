# OpenAI API Configuration (optional)
# Uncomment and add your API key to enable OpenAI integration
# OPENAI_API_KEY=your_openai_api_key_here

# Next.js Configuration
NEXT_PUBLIC_APP_NAME="Chat Assistant"
NEXT_PUBLIC_APP_DESCRIPTION="AI-Powered Chat Interface"

# Development
NODE_ENV=development
# Retriever
RETRIEVER_MODE=mock          # mock | milvus-lite
MILVUS_URI=http://milvus:19530
COLLECTION_NAME=colpali_multivector_collection
EMBED_DIM=64
DATA_DIR=/data
LOCAL_DATA_DIR=./local_data

# API
RETRIEVER_URL=http://localhost:8081
VLM_BASE_URL=http://host.docker.internal:11434/v1
VLM_MODEL=qwen2.5-vl:7b
